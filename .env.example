# Copy to .env and fill in. Loaded by scripts/dev.sh, which sources this file —
# so $(...) is evaluated, and nothing here may contain a real secret.
#
# Setup instructions: docs/local-setup.md

# --- OAuth App: identifies humans -------------------------------------------
FORGESTACK_GITHUB_OAUTH_CLIENT_ID=
FORGESTACK_GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App: the agent's authority --------------------------------------
# App ID is the number at the top of the App's General page.
# Slug is the last path segment of https://github.com/apps/<slug> — not the display name.
FORGESTACK_GITHUB_APP_ID=
FORGESTACK_GITHUB_APP_SLUG=

# The PEM content, not a path. GitHub downloads PKCS#1, which the JDK cannot read:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt \
#     -in <downloaded>.private-key.pem -out forgestack-app.pkcs8.pem
FORGESTACK_GITHUB_APP_PRIVATE_KEY_PEM="$(cat forgestack-app.pkcs8.pem)"

# A GitHub App also issues a Client ID and client secret. ForgeStack reads neither —
# App authentication is private key -> JWT. They exist only for the App's own
# user-authorization flow, which is deliberately left disabled.
